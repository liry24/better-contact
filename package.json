{
    "name": "better-contact-workspace",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "build": "vp -C packages/better-contact pack",
        "check": "vp check && vp run workspace:check && vp run unused && vp run typecheck && vp run build && vp test",
        "format": "vp fmt . --write",
        "format:check": "vp fmt . --check",
        "lint": "vp lint .",
        "typecheck": "tsc --noEmit -p test/tsconfig.json",
        "test": "vp test run",
        "test:integration": "vp test run test/integration",
        "test:unit": "vp test run test/unit",
        "test:consumer": "vp test run test/consumer",
        "workspace:check": "sherif",
        "unused": "knip && knip --production"
    },
    "devDependencies": {
        "@better-auth/core": "1.7.7",
        "@types/node": "^26.6.3",
        "auth": "1.7.7",
        "better-auth": "1.7.7",
        "knip": "^6.38.0",
        "sherif": "^1.13.0",
        "typescript": "^7.0.2",
        "valibot": "^1.5.0",
        "vite": "catalog:",
        "vite-plus": "catalog:",
        "vitest": "catalog:",
        "zod": "^4.5.4"
    },
    "overrides": {
        "vite": "catalog:",
        "vitest": "catalog:"
    },
    "engines": {
        "node": "^24.11.0 || >=26.0.0"
    },
    "packageManager": "bun@1.4.2",
    "catalog": {
        "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
        "vitest": "5.0.1",
        "vite-plus": "1.0.0"
    }
}
